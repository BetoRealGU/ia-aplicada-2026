        <mxCell id="XICA4zE9hEqmiPZ5rlZj-28" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Qué ocurre: Se analiza la información para mejorar las áreas verdes.&lt;/div&gt;&lt;div&gt;Responsable: Equipo del proyecto.&lt;/div&gt;&lt;div&gt;Control: Uso limitado al objetivo del proyecto.&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="135" x="332.5" y="290" as="geometry" />
