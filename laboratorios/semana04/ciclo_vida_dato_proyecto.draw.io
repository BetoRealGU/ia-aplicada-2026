        <mxCell id="XICA4zE9hEqmiPZ5rlZj-26" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Qué ocurre: Se recopila información sobre parques y áreas verdes.&lt;/div&gt;&lt;div&gt;Responsable: Equipo del proyecto.&lt;/div&gt;&lt;div&gt;Control: Captura mínima necesaria y registro de la fuente.&lt;/div&gt;" vertex="1">
