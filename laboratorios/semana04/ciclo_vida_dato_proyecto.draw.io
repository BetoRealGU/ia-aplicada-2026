        <mxCell id="XICA4zE9hEqmiPZ5rlZj-33" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;p dir=&quot;auto&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot; style=&quot;text-align: start;&quot;&gt;&lt;strong&gt;¿En qué etapa sale el dato del control de la organización?&lt;/strong&gt;&lt;span aria-hidden=&quot;true&quot; class=&quot;PDq2pG_selectionAnchor&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;blockquote style=&quot;text-align: start;&quot;&gt;&lt;p dir=&quot;auto&quot;&gt;El dato no sale del control de la organización porque no se utilizan servicios externos.&lt;/p&gt;&lt;/blockquote&gt;&lt;p dir=&quot;auto&quot; style=&quot;text-align: start;&quot;&gt;&lt;strong&gt;¿Qué control existe y por qué es suficiente?&lt;/strong&gt;&lt;/p&gt;&lt;blockquote style=&quot;text-align: start;&quot;&gt;&lt;p dir=&quot;auto&quot;&gt;El acceso está controlado y el dato se utiliza solo para el objetivo del proyecto.&lt;/p&gt;&lt;/blockquote&gt;" vertex="1">
