        <mxCell id="XICA4zE9hEqmiPZ5rlZj-29" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Qué ocurre: Se comparte la información necesaria con terceros autorizados.&lt;/div&gt;&lt;div&gt;Responsable: Líder del proyecto.&lt;/div&gt;&lt;div&gt;Control: Compartir solo los datos necesarios.&lt;/div&gt;" vertex="1">
